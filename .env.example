# Public URL. Used for absolute image links inside generated signatures, so it
# must be the real domain in production or images break in recipients' inboxes.
NEXT_PUBLIC_SITE_URL=https://mail.ikniteos.com

# Where uploaded portraits, logos and banners are written. On Railway this must
# point at a mounted volume, otherwise every deploy wipes the images and every
# signature already sent stops loading.
UPLOAD_DIR=/data/uploads

# GoHighLevel. Private Integration token and the Location that should receive
# leads. Without these the app still works and leads are written to
# UPLOAD_DIR/leads.ndjson, but nothing reaches the CRM.
GHL_API_TOKEN=
GHL_LOCATION_ID=
